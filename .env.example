# ---- Supabase (région EU ou CH uniquement) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # serveur uniquement, jamais dans les apps
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---- Stockage objets S3-compatible (EU/CH) ----
STORAGE_ENDPOINT=
STORAGE_BUCKET_PHOTOS=wallscan-photos
STORAGE_BUCKET_RENDERS=wallscan-renders
STORAGE_BUCKET_TEXTURES=wallscan-textures
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# ---- API ----
API_PORT=3001
API_JWT_SECRET=
CRM_CONFIG_ENCRYPTION_KEY=          # 32 octets base64, chiffrement des configs CRM au repos

# ---- Monitoring (EU) ----
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# ---- Apps ----
EXPO_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
