{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["App.tsx", "index.ts", "src/**/*.ts"],
  "exclude": ["node_modules", "android", "ios", ".expo"]
}
