{
  "name": "@wallscan/quote-engine",
  "version": "0.0.1",
  "private": true,
  "description": "Moteur de devis pur, déterministe, auditable (§5)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "build": "tsc --noEmit",
    "build:bundle": "esbuild src/index.ts --bundle --format=iife --global-name=WSQuote --platform=neutral --target=es2020 --outfile=dist/wsquote.iife.js --log-level=warning && node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@wallscan/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@vitest/coverage-v8": "^2.1.8",
    "esbuild": "^0.28.2"
  }
}
